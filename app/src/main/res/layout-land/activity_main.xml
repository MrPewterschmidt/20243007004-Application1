<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header banner shown at the top of the main screen -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Campus image used as the banner background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <!-- Welcome message displayed over the banner image -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/banner_title"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="40sp" />

    </FrameLayout>

    <!--
        Landscape category area.
        All four categories are displayed in one horizontal row.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Facilities category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Opens DetailActivity for the Facilities topic -->
            <ImageButton
                android:id="@+id/buttonFacilities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="facilitiesClicked"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/facilities"
                android:scaleType="centerInside"
                android:src="@drawable/img_btn_facilities" />

            <!-- Label for the Facilities button -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/facilities" />

        </LinearLayout>

        <!-- Events category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Opens DetailActivity for the Events topic -->
            <ImageButton
                android:id="@+id/buttonEvents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="eventsClicked"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/events"
                android:scaleType="centerInside"
                android:src="@drawable/img_btn_events" />

            <!-- Label for the Events button -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/events" />

        </LinearLayout>

        <!-- Clubs category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Opens DetailActivity for the Clubs topic -->
            <ImageButton
                android:id="@+id/buttonClubs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="clubsClicked"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/clubs"
                android:scaleType="centerInside"
                android:src="@drawable/img_btn_clubs" />

            <!-- Label for the Clubs button -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/clubs" />

        </LinearLayout>

        <!-- Support category -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Opens DetailActivity for the Support topic -->
            <ImageButton
                android:id="@+id/buttonSupport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="supportClicked"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/support"
                android:scaleType="centerInside"
                android:src="@drawable/img_btn_support" />

            <!-- Label for the Support button -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/support" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>